 DEVICE="cuda"

# Application host configuration (use 127.0.0.1 for local-only access)
 APP_HOST='0.0.0.0'
 APP_PORT=8003
 WORKERS=1

# Legacy variables maintained for compatibility
 UVICORN_HOST="${APP_HOST}"
 UVICORN_PORT="${APP_PORT}"
 UVICORN_WORKERS="${WORKERS}"


# Qdrant
QDRANT_HOST = 'localhost'
DB_COLLECTION_NAME_PHASE1 = 'All_phase1'
DB_COLLECTION_NAME_PHASE2 = 'All_phase2_512'
DB_LIMIT_PHASE1 = 500
DB_LIMIT_PHASE2 = 5
DB_DIMENSIONALITY_PHASE1 = 1024
DB_DIMENSIONALITY_PHASE2 = 512
DB_TYPE = 'qdrant'

# Embedding model
EMBEDDING_MODEL_PHASE1 = 'sscd'
EMBEDDING_MODEL_PHASE2 = 'sscd'
EMBEDDING_MODEL_PATH_PHASE1 = 'models/sscd_disc_large.torchscript.pt'
EMBEDDING_MODEL_PATH_PHASE2 = 'models/sscd_imagenet_mixup.torchscript.pt'

# Path settings
SAVE_INPUT_QUERY = 'False'
INPUT_QUERY_PATH = 'database/queries/'
DATABASE_PATH = 'database/safetensors_superpoint_feats/'
DATABASE_PATH_LIGHTGLUE = 'database/all_images/'

# disk settings
EXTRACTOR_MODEL = 'superpoint'
NUM_PATCH = 1
DISK_KEYPOINTS = 256
THRESHOLDS=[0.85, 0.8, 0.7]
#[0.7, 0.6, 0.5]
